//@version=5
strategy("10-Min Time Bin Movement Analysis", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
// ============================================
// INPUT SETTINGS
// ============================================
// Date Range Filter
startDate = input.time(timestamp("2024-01-01 00:00 +0000"), "Start Date", group="Date Range")
endDate = input.time(timestamp("2025-12-31 23:59 +0000"), "End Date", group="Date Range")
// Session Settings
sessionStart = input.session("0930-1600", "Trading Session", group="Session")
pipMultiplier = input.float(1.0, "Pip/Point Multiplier", minval=0.0001, step=0.0001, group="Settings", tooltip="For Forex pairs like EUR/USD use 10000, for indices use 1")
// Display Settings
bullColor = input.color(color.new(color.green, 20), "Bullish Bars", group="Display")
bearColor = input.color(color.new(color.red, 20), "Bearish Bars", group="Display")
neutralColor = input.color(color.new(color.gray, 20), "Neutral Bars", group="Display")
// ============================================
// DATE FILTER LOGIC
// ============================================
inDateRange = time >= startDate and time <= endDate
// ============================================
// 10-MINUTE BIN CALCULATION
// ============================================
// Get the current bar's time components
currentHour = hour(time)
currentMinute = minute(time)
// Calculate which 10-minute bin we're in (0-143 for 24 hours)
binIndex = (currentHour * 60 + currentMinute) / 10
// Track the open and close of each 10-min bin
var float binOpen = na
var float binHigh = na
var float binLow = na
var float binClose = na
var int lastBinIndex = -1
// Detect new 10-minute bin
newBin = binIndex != lastBinIndex
// Store bin values
if newBin
    binOpen := open
    binHigh := high
    binLow := low
    binClose := close
    lastBinIndex := int(binIndex)
else
    binHigh := math.max(nz(binHigh), high)
    binLow := math.min(nz(binLow, high), low)
    binClose := close
// Calculate movement in pips/points for the bin
binMovement = (binClose - binOpen) * pipMultiplier
binRange = (binHigh - binLow) * pipMultiplier
// ============================================
// PLOTTING - BAR CHART STYLE
// ============================================
// Determine bar color based on movement direction
barCol = binMovement > 0 ? bullColor : binMovement < 0 ? bearColor : neutralColor
// Plot the bin movement as histogram bars
plot(inDateRange ? binMovement : na, "Bin Movement (Pips/Points)", color=barCol, style=plot.style_columns, linewidth=3)
// Plot the range as a line for reference
plot(inDateRange ? binRange : na, "Bin Range", color=color.new(color.blue, 60), style=plot.style_line, linewidth=1)
// Zero line reference
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)
// ============================================
// INFORMATION TABLE
// ============================================
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast and inDateRange
    // Calculate session bin number (e.g., bin 1-39 for a 6.5 hour session)
    sessionBinNum = int(binIndex) - 56  // Adjusted for 9:30 AM start (56 = 9*6 + 2)
    
    table.cell(infoTable, 0, 0, "Current Bin Index", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(int(binIndex)), text_color=color.yellow, text_size=size.small)
    
    table.cell(infoTable, 0, 1, "Bin Time", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(currentHour, "00") + ":" + str.tostring(int(math.floor(currentMinute/10)*10), "00"), text_color=color.yellow, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "Movement (Pips)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(binMovement, "#.##"), text_color=binMovement >= 0 ? color.green : color.red, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "Range (Pips)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(binRange, "#.##"), text_color=color.aqua, text_size=size.small)
    
    table.cell(infoTable, 0, 4, "Bin Open", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(binOpen, "#.#####"), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 5, "Bin Close", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(binClose, "#.#####"), text_color=color.white, text_size=size.small)
// ============================================
// STRATEGY LOGIC (Simple demonstration)
// ============================================
// Example: Enter long if bin movement is positive, short if negative
if inDateRange and newBin
    if binMovement > 0
        strategy.entry("Long", strategy.long)
    else if binMovement < 0
        strategy.entry("Short", strategy.short)
// ============================================
// CUMULATIVE STATISTICS
// ============================================
var float totalBullishPips = 0.0
var float totalBearishPips = 0.0
var int bullishBins = 0
var int bearishBins = 0
if inDateRange and newBin and not na(binMovement[1])
    if binMovement[1] > 0
        totalBullishPips += binMovement[1]
        bullishBins += 1
    else if binMovement[1] < 0
        totalBearishPips += math.abs(binMovement[1])
        bearishBins += 1
// Stats Table
var table statsTable = table.new(position.bottom_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(statsTable, 0, 0, "📊 STATISTICS", text_color=color.yellow, text_size=size.normal)
    table.cell(statsTable, 1, 0, "", text_color=color.yellow, text_size=size.normal)
    
    table.cell(statsTable, 0, 1, "Bullish Bins", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 1, str.tostring(bullishBins), text_color=color.green, text_size=size.small)
    
    table.cell(statsTable, 0, 2, "Bearish Bins", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 2, str.tostring(bearishBins), text_color=color.red, text_size=size.small)
    
    table.cell(statsTable, 0, 3, "Total Bull Pips", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 3, str.tostring(totalBullishPips, "#.##"), text_color=color.green, text_size=size.small)
    
    table.cell(statsTable, 0, 4, "Total Bear Pips", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 4, str.tostring(totalBearishPips, "#.##"), text_color=color.red, text_size=size.small)
