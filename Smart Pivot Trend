//@version=6
indicator("Smart Pivot Trend", overlay = true, max_lines_count = 500, max_labels_count = 500)

// INPUTS
lenSwing = input.int(9, "Swing Length", minval = 2)
levelLow = input.float(0.15, "Lower Level", step = 0.01)
levelHigh = input.float(0.85, "Upper Level", step = 0.01)
atrLen = input.int(14, "ATR Length")
atrMult = input.float(4.0, "ATR Multiplier", step = 0.1)
smoothFactor = input.float(0.3, "Smooth Factor", step = 0.1, minval = 0.0)
hideAllLines = input.bool(false, "Hide level lines")
deleteBroken = input.bool(true, "Delete broken lines")

colorCandlesByTrend = input.bool(true, "Color candles by trend")
bullCandleColor     = input.color(color.rgb(0, 180, 80), "Bull trend candle color")
bearCandleColor     = input.color(color.rgb(220, 40, 40), "Bear trend candle color")

// COLORS
bullColor = input.color(color.rgb(6, 162, 47), "Bull Color")
bearColor = input.color(color.rgb(207, 23, 23), "Bear Color")
labelTextColor = input.color(color.white, "BUY/SELL label text color")

// ATR
atrVal = ta.atr(atrLen)

// PIVOTS
ph = ta.pivothigh(high, lenSwing, lenSwing)
pl = ta.pivotlow(low, lenSwing, lenSwing)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl
rangeReady = not na(lastPH) and not na(lastPL)

// RANGE LEVELS
rangeLineLow = rangeReady ? lastPL + (lastPH - lastPL) * levelLow : na
rangeLineHigh = rangeReady ? lastPL + (lastPH - lastPL) * levelHigh : na

// ATR-GUIDED CHASING
distHigh = math.abs(close - lastPH)
distLow = math.abs(close - lastPL)
if not na(lastPH) and distHigh > atrMult * atrVal
    delta = (close - lastPH) * smoothFactor
    candidate = lastPH + delta
    lastPH := close >= lastPH ? candidate : math.max(candidate, close)
if not na(lastPL) and distLow > atrMult * atrVal
    delta = (close - lastPL) * smoothFactor
    candidate = lastPL + delta
    lastPL := close <= lastPL ? candidate : math.min(candidate, close)
// SAFETY – line cannot go beyond current close
if not na(lastPL) and lastPL > close
    lastPL := close
if not na(lastPH) and lastPH < close
    lastPH := close

// TREND DIRECTION
var int trend = 0
var int prevTrend = 0
crossUp = ta.crossover(close, rangeLineHigh)
crossDown = ta.crossunder(close, rangeLineLow)
prevTrend := trend
if rangeReady
    if crossUp
        trend := 1
    else if crossDown
        trend := -1

// HISTORICAL LINES (with triangles)
var array<line> lines = array.new<line>()
var array<float> lvls = array.new<float>()
var array<bool> active = array.new<bool>()
var array<bool> isSupport = array.new<bool>()
var array<int> toRemove = array.new<int>()
if not hideAllLines and trend != prevTrend and rangeReady
    float fixedLevel = trend == 1 ? lastPL : lastPH
    color col = trend == 1 ? bullColor : bearColor
    bool supportType = trend == 1
    line newLine = line.new(
         bar_index, fixedLevel,
         bar_index + 1, fixedLevel,
         extend = extend.right,
         color = color.new(col, 10),
         width = 1)
    array.push(lines, newLine)
    array.push(lvls, fixedLevel)
    array.push(active, true)
    array.push(isSupport, supportType)

// BREAK DETECTION
var array<bool> brokenUp = array.new<bool>()
var array<bool> brokenDown = array.new<bool>()
array.clear(brokenUp)
array.clear(brokenDown)
if not hideAllLines and array.size(lines) > 0
    for i = 0 to array.size(lines) - 1
        if array.get(active, i)
            float thisLvl = array.get(lvls, i)
            line thisLine = array.get(lines, i)
            bool isSupp = array.get(isSupport, i)
            bool broken = isSupp ? close < thisLvl : close > thisLvl
            if broken
                line.set_extend(thisLine, extend.none)
                line.set_x2(thisLine, bar_index)
                array.set(active, i, false)
                if deleteBroken
                    line.delete(thisLine)
                    array.push(toRemove, i)
                if isSupp
                    array.push(brokenDown, true)
                else
                    array.push(brokenUp, true)

// CLEANUP
if array.size(toRemove) > 0
    array.sort(toRemove, order.descending)
    for i = 0 to array.size(toRemove) - 1
        idx = array.get(toRemove, i)
        array.remove(lines, idx)
        array.remove(lvls, idx)
        array.remove(active, idx)
        array.remove(isSupport, idx)
    array.clear(toRemove)

// BREAK SIGNALS
bool bullBreakSignal = array.size(brokenUp) > 0
bool bearBreakSignal = array.size(brokenDown) > 0

// TRIANGLES
plotshape(bullBreakSignal, title="Bullish Break", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny)
plotshape(bearBreakSignal, title="Bearish Break", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny)

// ACTIVE TREND LINE
activeLevel = trend == 1 ? lastPL : trend == -1 ? lastPH : na
activeColor = trend == 1 ? bullColor : trend == -1 ? bearColor : na
plot(activeLevel, "Active Trend Line", activeColor, linewidth = 2)

// FILL (gradient)
pCenter = plot(hl2, display = display.none)
pActive = plot(activeLevel, display = display.none)
float upper = math.max(activeLevel, hl2)
float lower = math.min(activeLevel, hl2)
color colStrong = color.new(activeColor, 75)
color colWeak = color.new(activeColor, 95)
fill(pCenter, pActive,
     top_value = upper,
     bottom_value = lower,
     top_color = upper == activeLevel ? colStrong : colWeak,
     bottom_color = upper == activeLevel ? colWeak : colStrong)

// BUY / SELL LABELS
bool showUpSignal = trend == 1 and prevTrend != 1
bool showDownSignal = trend == -1 and prevTrend != -1
bool isBullCandle = close > open
bool isBearCandle = close < open
float brokenDownLine = rangeLineLow[1]
float brokenUpLine = rangeLineHigh[1]
bool bullImpulseBreak = showUpSignal and isBullCandle and low < brokenDownLine
bool bearImpulseBreak = showDownSignal and isBearCandle and high > brokenUpLine
if showUpSignal
    label.new(
         bar_index,
         y = bullImpulseBreak ? low : activeLevel,
         text = "BUY",
         style = label.style_label_up,
         color = color.new(bullColor, 40),
         textcolor = labelTextColor,
         size = size.small)
if showDownSignal
    label.new(
         bar_index,
         y = bearImpulseBreak ? high : activeLevel,
         text = "SELL",
         style = label.style_label_down,
         color = color.new(bearColor, 40),
         textcolor = labelTextColor,
         size = size.small)

// COLOR CANDLES BY TREND
barcolor(colorCandlesByTrend ? (trend == 1 ? bullCandleColor : trend == -1 ? bearCandleColor : na) : na)

// ALERTS
alertcondition(showUpSignal, title="Trend → UP (BUY)", message="Smart Pivot Trend → BUY / trend ↑")
alertcondition(showDownSignal, title="Trend → DOWN (SELL)", message="Smart Pivot Trend → SELL / trend ↓")
alertcondition(bullBreakSignal, title="Bullish Break ↑", message="Bullish Break ↑ {{ticker}}")
alertcondition(bearBreakSignal, title="Bearish Break ↓", message="Bearish Break ↓ {{ticker}}")

