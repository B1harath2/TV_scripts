            orderBlockInfoF.timeframeStr := ob_timeframe1
            array.unshift(ob_allOrderBlocksList, ob_createOrderBlock(ob_orderBlockInfo.copy(orderBlockInfoF)))
    if ob_combineOBs
        ob_combineOBsFunc()    
    if array.size(ob_allOrderBlocksList) > 0
        for i = 0 to array.size(ob_allOrderBlocksList) - 1
            curOB = array.get(ob_allOrderBlocksList, i)
            if ob_isOBValid(curOB.info)
