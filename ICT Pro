            box.set_extend(_currentgap, extend.none)
            box.set_right(_currentgap, time)

fvg_validateFunc(_high, _low, _bearishgapholder, _bullishgapholder, _bearishgapholder_fill, _bullishgapholder_fill, _bearishmidholder, _bullishmidholder, _bearish_high_holder, _bullish_high_holder, _bearish_low_holder, _bullish_low_holder) =>
    fvg_removed = 0
    if array.size(_bullishgapholder) > 0
        for i = array.size(_bullishgapholder) - 1 to 0
            if fvg_extendB
                currentgap_fill = array.get(_bullishgapholder_fill, i)
                currentgap = array.get(_bullishgapholder, i)
                cmid = array.get(_bullishmidholder, i)
                chigh = array.get(_bullish_high_holder, i)
                clow = array.get(_bullish_low_holder, i)
                line.set_x2(cmid, timenow + (fvg_timediff) * fvg_extendLength)
                line.set_x2(chigh, timenow + (fvg_timediff) * fvg_extendLength)
                line.set_x2(clow, timenow + (fvg_timediff) * fvg_extendLength)
                box.set_right(currentgap_fill, timenow + (fvg_timediff) * fvg_extendLength)
                box.set_right(currentgap, timenow + (fvg_timediff) * fvg_extendLength)
            if fvg_mitigationFilter == 'Wicks'
                currentgap_fill = array.get(_bullishgapholder_fill, i)
                currentgap = array.get(_bullishgapholder, i)
                currentmid = array.get(_bullishmidholder, i)
                currenthigh = array.get(_bullish_high_holder, i)
                currentlow = array.get(_bullish_low_holder, i)
                currentbottom = box.get_bottom(currentgap)
                if _low < currentbottom
                    fvg_removed := 1
                    fvg_deleteFunc(currentgap, currentgap_fill, i, _bullishgapholder, _bullishgapholder_fill, _bullishmidholder, _bullish_high_holder, _bullish_low_holder, fvg_bullLabelHolder)
    if array.size(_bearishgapholder) > 0
        for i = array.size(_bearishgapholder) - 1 to 0
            if fvg_extendB
                currentgap_fill = array.get(_bearishgapholder_fill, i)
                currentgap = array.get(_bearishgapholder, i)
                cmid = array.get(_bearishmidholder, i)
                chigh = array.get(_bearish_high_holder, i)
                clow = array.get(_bearish_low_holder, i)
                line.set_x2(cmid, timenow + (fvg_timediff) * fvg_extendLength)
                line.set_x2(chigh, timenow + (fvg_timediff) * fvg_extendLength)
                line.set_x2(clow, timenow + (fvg_timediff) * fvg_extendLength)
                box.set_right(currentgap_fill, timenow + (fvg_timediff) * fvg_extendLength)
                box.set_right(currentgap, timenow + (fvg_timediff) * fvg_extendLength)
            if fvg_mitigationFilter == 'Wicks'
                currentgap_fill = array.get(_bearishgapholder_fill, i)
                currentgap = array.get(_bearishgapholder, i)
                currentmid = array.get(_bearishmidholder, i)
                currenthigh = array.get(_bearish_high_holder, i)
                currentlow = array.get(_bearish_low_holder, i)
                currenttop = box.get_top(currentgap)
                if _high > currenttop
                    fvg_removed := -1
                    fvg_deleteFunc(currentgap, currentgap_fill, i, _bearishgapholder, _bearishgapholder_fill, _bearishmidholder, _bearish_high_holder, _bearish_low_holder, fvg_bearLabelHolder)
    fvg_removed

fvg_validateAndShift(_fvg_holder, _fvg_fill_holder, _mid_holder, _high_holder, _low_holder, _label_holder, max_fvg) =>
    if array.size(_fvg_holder) > max_fvg
        d_box = array.shift(_fvg_holder)
        box.delete(d_box)
    if array.size(_fvg_fill_holder) > max_fvg
        d_box = array.shift(_fvg_fill_holder)
        box.delete(d_box)
    if array.size(_mid_holder) > max_fvg
        d_line = array.shift(_mid_holder)
        line.delete(d_line)
    if array.size(_high_holder) > max_fvg
        d_line = array.shift(_high_holder)
        line.delete(d_line)
    if array.size(_low_holder) > max_fvg
        d_line = array.shift(_low_holder)
        line.delete(d_line)

// Request Security
fvg_sClose := request.security(ticker.standard(syminfo.tickerid), fvg_tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
fvg_sHighP2 := request.security(ticker.standard(syminfo.tickerid), fvg_tf, high[2], barmerge.gaps_off, barmerge.lookahead_on)
fvg_sLowP2 := request.security(ticker.standard(syminfo.tickerid), fvg_tf, low[2], barmerge.gaps_off, barmerge.lookahead_on)
fvg_sOpen := request.security(ticker.standard(syminfo.tickerid), fvg_tf, open[1], barmerge.gaps_off, barmerge.lookahead_on)
fvg_sBar := request.security(ticker.standard(syminfo.tickerid), fvg_tf, bar_index, barmerge.gaps_off, barmerge.lookahead_on)
fvg_sTime2 := request.security(ticker.standard(syminfo.tickerid), fvg_tf, time[2], barmerge.gaps_off, barmerge.lookahead_on)
fvg_sHigh := request.security(ticker.standard(syminfo.tickerid), fvg_tf, high, barmerge.gaps_off, barmerge.lookahead_on)
fvg_sLow := request.security(ticker.standard(syminfo.tickerid), fvg_tf, low, barmerge.gaps_off, barmerge.lookahead_on)

if fvg_isNewbar(fvg_tf)
    fvg_htfH := fvg_sHigh
    fvg_htfL := fvg_sLow

// Execution
fvg_gap = 0

fvg_validateAndShift(fvg_bullBoxHolder, fvg_bullBoxFillHolder, fvg_bullMidHolder, fvg_bullHighHolder, fvg_bullLowHolder, fvg_bullLabelHolder, fvg_bullCount)
fvg_validateAndShift(fvg_bearBoxHolder, fvg_bearBoxFillHolder, fvg_bearMidHolder, fvg_bearHighHolder, fvg_bearLowHolder, fvg_bearLabelHolder, fvg_bearCount)

fvg_removed = fvg_validateFunc(high, low, fvg_bearBoxHolder, fvg_bullBoxHolder, fvg_bearBoxFillHolder, fvg_bullBoxFillHolder, fvg_bearMidHolder, fvg_bullMidHolder, fvg_bearHighHolder, fvg_bullHighHolder, fvg_bearLowHolder, fvg_bullLowHolder)

if fvg_show and fvg_isNewbar(fvg_tf) and barstate.isconfirmed
    fvg_gap := fvg_checkFunc(fvg_sClose, fvg_htfH, fvg_sHighP2, fvg_htfL, fvg_sLowP2, fvg_sOpen, fvg_sTime2, true, fvg_tf)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOGIC - MARKET STRUCTURE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Hardcoded Settings
ms_internalLength = 10
ms_externalLength = 50
ms_label_size_Internal = size.small
ms_label_size_External = size.small

// Variables
color ms_transparent = #ffffff00
ms_showInternalMS = (ms_length_option == "INTERNAL" or ms_length_option == "ALL") and ms_length_option != "NONE"
ms_showExternalMS = (ms_length_option == "EXTERNAL" or ms_length_option == "ALL") and ms_length_option != "NONE"
var ms_t_MS = 0
var ms_int_t_MS = 0
var ms_internal_y_up = 0.
var ms_internal_x_up = 0
var ms_internal_y_dn = 0.
var ms_internal_x_dn = 0
var ms_y_up = 0.
var ms_x_up = 0
var ms_y_dn = 0.
var ms_x_dn = 0
var ms_crossed_up = true
var ms_crossed_down = true
var ms_internal_up_broke = true
var ms_internal_dn_broke = true
ms_n = bar_index

// Functions
ms_Show_MS(x, y, txt, css, dashed, down, lbl_size) =>
    label.new(int(math.avg(x, bar_index)), y, txt, color = ms_transparent, textcolor = css, style = down ? label.style_label_down : label.style_label_up, size = lbl_size)
    line.new(x, y, bar_index, y, color = css, style = dashed ? line.style_dashed : line.style_solid)

ms_calculate_swing_points(length) =>
    var prev = 0
    prev := high[length] > ta.highest(length) ? 0 : low[length] < ta.lowest(length) ? 1 : prev[1]
    t = prev == 0 and prev[1] != 0 ? high[length] : 0
    b = prev == 1 and prev[1] != 1 ? low[length] : 0
    [t, b]

// Execution - BOS & CHOCH
[ms_high_ms, ms_low_ms] = ms_calculate_swing_points(ms_externalLength)
[ms_int_high_ms, ms_int_low_ms] = ms_calculate_swing_points(ms_internalLength)

if ms_low_ms
    ms_crossed_down := true
    ms_y_dn := ms_low_ms
    ms_x_dn := ms_n - ms_externalLength
if ms_high_ms
    ms_crossed_up := true
    ms_y_up := ms_high_ms
    ms_x_up := ms_n - ms_externalLength
if ms_int_low_ms
    ms_internal_dn_broke := true
    ms_internal_y_dn := ms_int_low_ms
    ms_internal_x_dn := ms_n - ms_internalLength
if ms_int_high_ms
    ms_internal_up_broke := true
    ms_internal_y_up := ms_int_high_ms
    ms_internal_x_up := ms_n - ms_internalLength

ms_bull_CHOCH = false
ms_bull_CHOCH_ = false
ms_bull_bos = false
ms_bull_bos_ = false
ms_bear_CHOCH = false
ms_bear_CHOCH_ = false
ms_bear_bos = false
ms_bear_bos_ = false

if ta.crossover(close, ms_internal_y_up) and ms_internal_up_broke and ms_y_up != ms_internal_y_up
    bool CHOCH = ms_int_t_MS < 0
    ms_internal_up_broke := false
    ms_int_t_MS := 1
    ms_bull_CHOCH := CHOCH ? true : false
    ms_bull_bos := CHOCH ? false : true
    if ms_showInternalMS
        ms_Show_MS(ms_internal_x_up, ms_internal_y_up, CHOCH ? "choch" : "bos", ms_internalBullColor, true, true, ms_label_size_Internal)

if ta.crossunder(close, ms_internal_y_dn) and ms_internal_dn_broke and ms_y_dn != ms_internal_y_dn
    bool CHOCH = ms_int_t_MS > 0
    ms_internal_dn_broke := false
    ms_int_t_MS := -1
    ms_bear_CHOCH := CHOCH ? true : false
    ms_bear_bos := CHOCH ? false : true
    if ms_showInternalMS
        ms_Show_MS(ms_internal_x_dn, ms_internal_y_dn, CHOCH ? "choch" : "bos", ms_internalBearColor, true, false, ms_label_size_Internal)

if ta.crossover(close, ms_y_up) and ms_crossed_up
    bool MSS = ms_t_MS < 0
    ms_crossed_up := false
    ms_t_MS := 1
    ms_bull_CHOCH_ := MSS ? true : false
    ms_bull_bos_ := MSS ? false : true
    if ms_showExternalMS
        ms_Show_MS(ms_x_up, ms_y_up, MSS ? "CHOCH" : "BOS", ms_externalBullColor, false, true, ms_label_size_External)

if ta.crossunder(close, ms_y_dn) and ms_crossed_down
    bool MSS = ms_t_MS > 0
    ms_crossed_down := false
    ms_t_MS := -1
    ms_bear_CHOCH_ := MSS ? true : false
    ms_bear_bos_ := MSS ? false : true
    if ms_showExternalMS
        ms_Show_MS(ms_x_dn, ms_y_dn, MSS ? "CHOCH" : "BOS", ms_externalBearColor, false, false, ms_label_size_External)

