// Types
type ob_orderBlockInfo
    float top
    float bottom
    float obOpen
    float obClose
    float obVolume
    string obType
    int startTime
    float bbVolume
    float obLowVolume
    float obHighVolume
    bool breaker
    int breakTime
    string timeframeStr
    bool disabled = false
    string combinedTimeframesStr = na
    bool combined = false

type ob_orderBlock
    ob_orderBlockInfo info
    bool isRendered = false
    box orderBox = na
    box breakerBox = na
    line orderBoxLineTop = na
    line orderBoxLineBottom = na
    line breakerBoxLineTop = na
    line breakerBoxLineBottom = na
    line obBodyTop = na
    line obBodyBottom = na
    box orderBoxText = na
    box orderBoxPositive = na
    box orderBoxNegative = na
    line orderSeperator = na
    line orderTextSeperator = na

type ob_obSwing
    int x = na    
    float y = na
    float swingVolume = na
    bool crossed = false

// Variables
const float ob_overlapThresholdPercentage = 0
const int ob_maxDistanceToLastBar = 1750 
const int ob_maxOrderBlocks = 30

var ob_bullishOrderBlocksList = array.new<ob_orderBlockInfo>(0)
var ob_bearishOrderBlocksList = array.new<ob_orderBlockInfo>(0)
var ob_allOrderBlocksList = array.new<ob_orderBlock>(0)

// Functions
ob_createOrderBlock (ob_orderBlockInfo orderBlockInfoF) =>
    ob_orderBlock newOrderBlock = ob_orderBlock.new(orderBlockInfoF)
    newOrderBlock

ob_safeDeleteOrderBlock (ob_orderBlock orderBlockF) =>
    orderBlockF.isRendered := false
    box.delete(orderBlockF.orderBox)
    box.delete(orderBlockF.breakerBox)
    box.delete(orderBlockF.orderBoxText)
    box.delete(orderBlockF.orderBoxPositive)
    box.delete(orderBlockF.orderBoxNegative)
    line.delete(orderBlockF.orderBoxLineTop)
    line.delete(orderBlockF.orderBoxLineBottom)
    line.delete(orderBlockF.breakerBoxLineTop)
    line.delete(orderBlockF.breakerBoxLineBottom)
    line.delete(orderBlockF.orderSeperator)
    line.delete(orderBlockF.orderTextSeperator)
    line.delete(orderBlockF.obBodyTop)
    line.delete(orderBlockF.obBodyBottom)

ob_moveLine(_line, _x, _y, _x2) =>
    line.set_xy1(_line, _x,  _y)
    line.set_xy2(_line, _x2, _y)

ob_moveBox (_box, _topLeftX, _topLeftY, _bottomRightX, _bottomRightY) =>
    box.set_lefttop(_box, _topLeftX, _topLeftY)
    box.set_rightbottom(_box, _bottomRightX, _bottomRightY)

ob_formatTimeframeString (formatTimeframe) =>
    timeframeF = formatTimeframe == "" ? timeframe.period : formatTimeframe
    if str.contains(timeframeF, "D") or str.contains(timeframeF, "W") or str.contains(timeframeF, "S") or str.contains(timeframeF, "M")
        timeframeF
    else
        seconds = timeframe.in_seconds(timeframeF)
        if seconds >= 3600
            hourCount = int(seconds / 3600)
            str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
        else
            timeframeF + " Min"

ob_colorWithTransparency (colorF, transparencyX) =>
    color.new(colorF, color.t(colorF) * transparencyX)

ob_createOBBox (boxColor, textSize, transparencyX = 1.0, xlocType = xloc.bar_time, borderWidth = 1) =>
    box.new(na, na, na, na, text_size = textSize, xloc = xlocType, extend = extend.none, bgcolor = ob_colorWithTransparency(boxColor, transparencyX), text_color = ob_textColor, text_halign = text.align_center, border_color = boxColor, border_width = borderWidth)

ob_getTextSize(textSizeOptionF) =>
    if textSizeOptionF == "XS"
        size.tiny
    else if textSizeOptionF == "S"
        size.small
    else if textSizeOptionF == "M"
        size.normal    
    else if textSizeOptionF == "L"
        size.large
    else if textSizeOptionF == "XL"
        size.huge    

ob_renderOrderBlock (ob_orderBlock ob) =>
    ob_orderBlockInfo info = ob.info
    ob.isRendered := true
    orderColor = ob.info.obType == "Bull" ? ob_bullOrderBlockColor : ob_bearOrderBlockColor
    showOB = not info.breaker and ob_showOBs
    showBB = info.breaker and ob_showBBs
    if ob_OBsEnabled and (showOB or showBB) and not (not ob_showInvalidated and info.breaker)
        textSize = ob_getTextSize(ob_textSizeOption)
        borderThickness = info.breaker ? 1 : 2
        ob.orderBox := ob_createOBBox(orderColor, textSize, 1.5, xloc.bar_time, borderThickness)
        if ob.info.combined
            ob.orderBox.set_bgcolor(ob_colorWithTransparency(orderColor, 1.1))
        ob.orderBoxText := ob_createOBBox(color.new(color.white, 100), textSize)
        if ob_showVolume or ob_showPercentage
            ob.orderBoxPositive := ob_createOBBox(ob_bullOrderBlockinColor, textSize)
            ob.orderBoxNegative := ob_createOBBox(ob_bearOrderBlockinColor, textSize)
            ob.orderSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,ob_textColor,line.style_dashed,1)
            ob.orderTextSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,ob_textColor,line.style_solid,1)
        zoneSize = time - info.startTime + ob_adjustableLength * timeframe.in_seconds(timeframe.period)
        startX = ob_volumeBarsLeftSide ? info.startTime : info.startTime + zoneSize - zoneSize / 3
        maxEndX = ob_volumeBarsLeftSide ? info.startTime + zoneSize / 3 : info.startTime + zoneSize
        ob_moveBox(ob.orderBox, info.startTime, info.top, info.startTime + zoneSize, info.bottom)
        ob_moveBox(ob.orderBoxText, ob_volumeBarsLeftSide ? maxEndX : info.startTime, info.top, ob_volumeBarsLeftSide ? info.startTime + zoneSize : startX, info.bottom)
        percentage = int((math.min(info.obHighVolume, info.obLowVolume) / math.max(info.obHighVolume, info.obLowVolume)) * 100.0)
        OBText = ob_formatTimeframeString(ob.info.timeframeStr) + " " + (ob.info.obType == "Bull" ? "Bull " : "Bear ") + "OB"
        textToDisplay = ""
        if ob_showTimeframeOB
            textToDisplay += OBText
        volumeLine = ""
        if ob_showVolume or ob_showPercentage
            if ob_showVolume
                volumeLine += "Vol: " + str.tostring(ob.info.obVolume, format.volume)
            if ob_showPercentage
                percentage := int((math.min(info.obHighVolume, info.obLowVolume) / math.max(info.obHighVolume, info.obLowVolume)) * 100.0)
                volumeLine += " (" + str.tostring(percentage) + "%)"
            if textToDisplay != ""
                textToDisplay += "\n" + volumeLine
            else
                textToDisplay := volumeLine
        box.set_text(ob.orderBoxText, textToDisplay)
        if ob_showVolume or ob_showPercentage
            showHighLowBoxText = false
            curEndXHigh = int(math.ceil((info.obHighVolume / info.obVolume) * (maxEndX - startX) + startX))
            curEndXLow = int(math.ceil((info.obLowVolume / info.obVolume) * (maxEndX - startX) + startX))
            ob_moveBox(ob.orderBoxPositive, ob_mirrorVolumeBars ? startX : curEndXLow, info.top, ob_mirrorVolumeBars ? curEndXHigh : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxPositive, showHighLowBoxText ? str.tostring(info.obHighVolume, format.volume) : "")
            ob_moveBox(ob.orderBoxNegative, ob_mirrorVolumeBars ? startX : curEndXHigh, info.bottom, ob_mirrorVolumeBars ? curEndXLow : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxNegative, showHighLowBoxText ? str.tostring(info.obLowVolume, format.volume) : "")
            ob_moveLine(ob.orderSeperator, ob_volumeBarsLeftSide ? startX : maxEndX, (info.bottom + info.top) / 2, ob_volumeBarsLeftSide ? maxEndX : startX)
            line.set_xy1(ob.orderTextSeperator, ob_volumeBarsLeftSide ? maxEndX : startX, info.top)
            line.set_xy2(ob.orderTextSeperator, ob_volumeBarsLeftSide ? maxEndX : startX, info.bottom)
        if ob_showOBBody and not na(info.obOpen) and not na(info.obClose)
            bodyTop = math.max(info.obOpen, info.obClose)
            bodyBottom = math.min(info.obOpen, info.obClose)
            zoneEnd = info.startTime + zoneSize
            ob.obBodyTop := line.new(info.startTime, bodyTop, zoneEnd, bodyTop, xloc.bar_time, extend.none, orderColor, line.style_dotted, 2)
            ob.obBodyBottom := line.new(info.startTime, bodyBottom, zoneEnd, bodyBottom, xloc.bar_time, extend.none, orderColor, line.style_dotted, 2)

ob_findOBSwings(len) =>
    var swingType = 0
    var ob_obSwing top = ob_obSwing.new(na, na)
    var ob_obSwing bottom = ob_obSwing.new(na, na)
    upper = ta.highest(len)
    lower = ta.lowest(len)
    swingType := high[len] > upper ? 0 : low[len] < lower ? 1 : swingType
    if swingType == 0 and swingType[1] != 0
        top := ob_obSwing.new(bar_index[len], high[len], volume[len])
    if swingType == 1 and swingType[1] != 1
        bottom := ob_obSwing.new(bar_index[len], low[len], volume[len])
    [top, bottom]

ob_findOrderBlocks (length) =>
    [top, btm] = ob_findOBSwings(length)
    if bar_index > last_bar_index - ob_maxDistanceToLastBar
        useBody = false
        max = useBody ? math.max(close, open) : high
        min = useBody ? math.min(close, open) : low
        if array.size(ob_bullishOrderBlocksList) > 0
            for i = array.size(ob_bullishOrderBlocksList) - 1 to 0
                currentOB = array.get(ob_bullishOrderBlocksList, i)
                if not na(currentOB) and not currentOB.breaker
                    if (ob_obEndMethod == "Wick" ? low : math.min(open, close)) < currentOB.bottom
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if not na(currentOB) and high > currentOB.top
                        array.remove(ob_bullishOrderBlocksList, i)
        if close > top.y and not top.crossed
            top.crossed := true
            boxBtm = max[1]
            boxTop = min[1]
            boxLoc = time[1]
            boxOpen = open[1]
            boxClose = close[1]
            for i = 1 to (bar_index - top.x) - 1
                if open[i] > close[i]
                    boxBtm := math.min(min[i], boxBtm)
                    boxTop := boxBtm == min[i] ? max[i] : boxTop
                    boxLoc := boxBtm == min[i] ? time[i] : boxLoc
                    boxOpen := boxBtm == min[i] ? open[i] : boxOpen
                    boxClose := boxBtm == min[i] ? close[i] : boxClose
            newOrderBlockInfo = ob_orderBlockInfo.new(boxTop, boxBtm, boxOpen, boxClose, volume + volume[1] + volume[2], "Bull", boxLoc)
            newOrderBlockInfo.obLowVolume := volume[2]
            newOrderBlockInfo.obHighVolume := volume + volume[1]
            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= ob_atr * ob_maxATRMult
                array.unshift(ob_bullishOrderBlocksList, newOrderBlockInfo)
                if array.size(ob_bullishOrderBlocksList) > ob_maxOrderBlocks
                    array.pop(ob_bullishOrderBlocksList)
        if array.size(ob_bearishOrderBlocksList) > 0
            for i = array.size(ob_bearishOrderBlocksList) - 1 to 0
                currentOB = array.get(ob_bearishOrderBlocksList, i)
                if not na(currentOB) and not currentOB.breaker
                    if (ob_obEndMethod == "Wick" ? high : math.max(open, close)) > currentOB.top
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if not na(currentOB) and low < currentOB.bottom
                        array.remove(ob_bearishOrderBlocksList, i)
        if close < btm.y and not btm.crossed
            btm.crossed := true
            boxBtm = min[1]
            boxTop = max[1]
            boxLoc = time[1]
            boxOpen = open[1]
            boxClose = close[1]
            for i = 1 to (bar_index - btm.x) - 1
                if close[i] > open[i]
                    boxTop := math.max(max[i], boxTop)
                    boxBtm := boxTop == max[i] ? min[i] : boxBtm
                    boxLoc := boxTop == max[i] ? time[i] : boxLoc
                    boxOpen := boxTop == max[i] ? open[i] : boxOpen
                    boxClose := boxTop == max[i] ? close[i] : boxClose
            newOrderBlockInfo = ob_orderBlockInfo.new(boxTop, boxBtm, boxOpen, boxClose, volume + volume[1] + volume[2], "Bear", boxLoc)
            newOrderBlockInfo.obLowVolume := volume + volume[1]
            newOrderBlockInfo.obHighVolume := volume[2]
            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= ob_atr * ob_maxATRMult
                array.unshift(ob_bearishOrderBlocksList, newOrderBlockInfo)
                if array.size(ob_bearishOrderBlocksList) > ob_maxOrderBlocks
                    array.pop(ob_bearishOrderBlocksList)
    true

ob_areaOfOB (ob_orderBlockInfo OBInfoF) =>
    float XA1 = OBInfoF.startTime
    float XA2 = na(OBInfoF.breakTime) ? time + 1 : OBInfoF.breakTime
    float YA1 = OBInfoF.top
    float YA2 = OBInfoF.bottom
    float edge1 = math.sqrt((XA2 - XA1) * (XA2 - XA2) + (YA2 - YA2) * (YA2 - YA2))
    float edge2 = math.sqrt((XA2 - XA2) * (XA2 - XA2) + (YA2 - YA1) * (YA2 - YA1))
    float totalArea = edge1 * edge2
    totalArea

ob_doOBsTouch (ob_orderBlockInfo OBInfo1, ob_orderBlockInfo OBInfo2) =>
    float XA1 = OBInfo1.startTime
    float XA2 = na(OBInfo1.breakTime) ? time + 1 : OBInfo1.breakTime
    float YA1 = OBInfo1.top
    float YA2 = OBInfo1.bottom
    float XB1 = OBInfo2.startTime
    float XB2 = na(OBInfo2.breakTime) ? time + 1 : OBInfo2.breakTime
    float YB1 = OBInfo2.top
    float YB2 = OBInfo2.bottom
    float intersectionArea = math.max(0, math.min(XA2, XB2) - math.max(XA1, XB1)) * math.max(0, math.min(YA1, YB1) - math.max(YA2, YB2))
    float unionArea = ob_areaOfOB(OBInfo1) + ob_areaOfOB(OBInfo2) - intersectionArea
    float overlapPercentage = (intersectionArea / unionArea) * 100.0
    if overlapPercentage > ob_overlapThresholdPercentage
        true
    else
        false

ob_isOBValid (ob_orderBlockInfo OBInfo) =>
    valid = true
    if OBInfo.disabled
        valid := false
    valid

ob_combineOBsFunc () =>
    if array.size(ob_allOrderBlocksList) > 0
        lastCombinations = 999
        while lastCombinations > 0
            lastCombinations := 0
            for i = 0 to array.size(ob_allOrderBlocksList) - 1
                curOB1 = array.get(ob_allOrderBlocksList, i)
                for j = 0 to array.size(ob_allOrderBlocksList) - 1
                    curOB2 = array.get(ob_allOrderBlocksList, j)
                    if i == j
                        continue
                    if not ob_isOBValid(curOB1.info) or not ob_isOBValid(curOB2.info)
                        continue
                    if curOB1.info.obType != curOB2.info.obType
                        continue
                    if ob_doOBsTouch(curOB1.info, curOB2.info)
                        curOB1.info.disabled := true
                        curOB2.info.disabled := true
                        ob_orderBlock newOB = ob_createOrderBlock(ob_orderBlockInfo.new(math.max(curOB1.info.top, curOB2.info.top), math.min(curOB1.info.bottom, curOB2.info.bottom), na, na, curOB1.info.obVolume + curOB2.info.obVolume, curOB1.info.obType))
                        newOB.info.startTime := math.min(curOB1.info.startTime, curOB2.info.startTime)
                        newOB.info.breakTime := math.max(nz(curOB1.info.breakTime), nz(curOB2.info.breakTime))
                        newOB.info.breakTime := newOB.info.breakTime == 0 ? na : newOB.info.breakTime
                        newOB.info.timeframeStr := curOB1.info.timeframeStr
                        newOB.info.obVolume := curOB1.info.obVolume + curOB2.info.obVolume
                        newOB.info.obLowVolume := curOB1.info.obLowVolume + curOB2.info.obLowVolume
                        newOB.info.obHighVolume := curOB1.info.obHighVolume + curOB2.info.obHighVolume
                        newOB.info.bbVolume := nz(curOB1.info.bbVolume, 0) + nz(curOB2.info.bbVolume, 0)
                        newOB.info.breaker := curOB1.info.breaker or curOB2.info.breaker
                        newOB.info.combined := true
                        array.unshift(ob_allOrderBlocksList, newOB)
                        lastCombinations += 1

ob_handleOrderBlocksFinal () =>
    if array.size(ob_allOrderBlocksList) > 0
        for i = 0 to array.size(ob_allOrderBlocksList) - 1
            ob_safeDeleteOrderBlock(array.get(ob_allOrderBlocksList, i))
    array.clear(ob_allOrderBlocksList)    
    if not na(ob_bullishOrderBlocksList) and array.size(ob_bullishOrderBlocksList) > 0
        for j = 0 to math.min(array.size(ob_bullishOrderBlocksList) - 1, ob_bullishOrderBlocks - 1)
