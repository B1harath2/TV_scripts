    if _close > _open
        if _low > _highp2
            if not(fvg_removeSmall) or math.abs(_low - _highp2) > thold_
                upperlimit = _low
                lowerlimit = _highp2
                midlimit = lowerlimit + ((upperlimit - lowerlimit) / 2.)
                gap := 1
                fvg_createFunc(upperlimit, lowerlimit, midlimit, _bar, fvg_bullBoxHolder, fvg_bullBoxFillHolder, fvg_bullMidHolder, fvg_bullHighHolder, fvg_bullLowHolder, fvg_bullLabelHolder, fvg_bullColorInternal, fvg_bullColor, _htf, tf)
    else
        if _lowp2 > _high
            if not(fvg_removeSmall) or math.abs(_lowp2 - _high) > thold_
                upperlimit = _lowp2
                lowerlimit = _high
                midlimit = lowerlimit + ((upperlimit - lowerlimit) / 2.)
                gap := -1
                fvg_createFunc(upperlimit, lowerlimit, midlimit, _bar, fvg_bearBoxHolder, fvg_bearBoxFillHolder, fvg_bearMidHolder, fvg_bearHighHolder, fvg_bearLowHolder, fvg_bearLabelHolder, fvg_bearColorInternal, fvg_bearColor, _htf, tf)
