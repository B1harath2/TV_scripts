//@version=5
indicator('Volume Pressue Based Buy and Sell Signals', shorttitle='VP' , overlay = true) 

length = input.int(21, 'Period Length', minval=1)
vp = math.sum(volume * (close - open), length) / math.sum(volume, length)

// Moving Average
maLength = input.int(10, 'Moving Average Length', minval=1)
ma_type = input.string('SMA', 'Moving Average Type', options=['SMA', 'EMA', 'WMA', 'VWMA'])

vpMa = 0.0  // Declare and initialize vpMa variable

if ma_type == 'SMA'
    vpMa := ta.sma(vp, maLength)
else if ma_type == 'EMA'
    vpMa := ta.ema(vp, maLength)
else if ma_type == 'WMA'
    vpMa := ta.wma(vp, maLength)
else if ma_type == 'VWMA'
    vpMa := ta.vwma(vp, maLength)


BuySignal = ta.crossover(vp, vpMa)
SellSignal = ta.crossunder(vp, vpMa)

plotshape(BuySignal, title='Buy Signal', location=location.belowbar, style=shape.triangleup, color=color.rgb(0, 75, 3))
plotshape(SellSignal, title='Sell Signal', location=location.abovebar, style=shape.triangledown, color=color.rgb(138, 0, 0))
